# ---------------------------------------------------------------------------
# Supabase (required). Local values are printed by `npx supabase status`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lifetime of signed page-image URLs, seconds (default 300).
# SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Payments: "mock" (default, no external calls) or "stripe".
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# --- Only needed when PAYMENT_PROVIDER=stripe -------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_SUBSCRIPTION=price_...
# Coin pack price IDs (env overrides pricing_plans.stripe_price_id):
# STRIPE_PRICE_ID_COINS_50=price_...
# STRIPE_PRICE_ID_COINS_120=price_...
# STRIPE_PRICE_ID_COINS_300=price_...
